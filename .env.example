# Supabase Configuration
# Get these values from your Supabase project dashboard:
# https://app.supabase.com/project/_/settings/api

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Aviation Weather API Configuration
# Uses AviationWeather.gov (NOAA) via Cloudflare Worker proxy

# Your Cloudflare Worker URL (see cloudflare-worker/weather-proxy.js and WEATHER_API_SETUP.md)
# Example: https://weather-proxy.your-username.workers.dev
VITE_WEATHER_API_URL=https://weather-proxy.ian-284.workers.dev
